{
  "manifest_version": 3,
  "name": "STOMP WebSocket Interceptor & Replayer",
  "version": "1.0.0",
  "description": "Intercepts STOMP over WebSocket traffic via DevTools Protocol, records to Dexie DB, and replays messages for client/server testing.",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/sockjs-hook.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "STOMP Interceptor"
  },
  "options_ui": {
    "page": "src/dashboard/index.html",
    "open_in_tab": true
  }
}
